# Development infrastructure
POSTGRES_DB=buildflow
POSTGRES_USER=buildflow
POSTGRES_PASSWORD=change-this-local-password

# API configuration
ConnectionStrings__BuildFlow=Host=postgres;Port=5432;Database=buildflow;Username=buildflow;Password=change-this-local-password
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=buildflow-api
Jwt__Audience=buildflow-web
Cors__Origin=http://localhost:5173

# Leave empty for local development. Set this when deploying to Azure.
AzureStorage__ConnectionString=

